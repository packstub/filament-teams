{
    "name": "packstub/filament-teams",
    "description": "Teams, invitations and seat limits for Filament tenants — email invitations, a Members page, ownership rules and tenant-scoped roles that plug into Filament Shield / Spatie Permission when present.",
    "keywords": [
        "packstub",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v5",
        "filament-teams",
        "teams",
        "invitations",
        "members",
        "tenant-roles",
        "multi-tenancy",
        "shield",
        "spatie-permission",
        "saas"
    ],
    "homepage": "https://packstub.dev",
    "support": {
        "email": "support@packstub.dev",
        "issues": "https://github.com/packstub/filament-teams/issues",
        "docs": "https://packstub.dev/docs/filament-teams"
    },
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0",
        "spatie/laravel-permission": "^6.0 || ^7.0 || ^8.0"
    },
    "suggest": {
        "spatie/laravel-permission": "Enable the `teams` feature to give members tenant-scoped Spatie roles; Filament Shield then manages their permissions.",
        "bezhansalleh/filament-shield": "Role & permission UI for the roles the Members page assigns."
    },
    "autoload": {
        "psr-4": {
            "Packstub\\Teams\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\Teams\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\Teams\\TeamsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
